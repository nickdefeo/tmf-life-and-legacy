# ============================================================================
#  TMF Life & Legacy — Environment Variables
# ============================================================================
#  Copy this file to `.env.local` and fill in real values before deploying.
#  On Vercel, add these under Project Settings → Environment Variables.
#  Nothing here is required for the site to BUILD or RUN — these are only
#  needed when you wire the contact/quote form up to a real provider.
# ----------------------------------------------------------------------------

# Where the quote / careers form submits to.
# Leave blank to use the built-in mailto: fallback (see lib/site-config + ContactForm).
# Example: a Formspree, Basin, or your own /api route.
NEXT_PUBLIC_FORM_ENDPOINT=

# The inbox that should receive form submissions (used by the mailto fallback,
# and by your form provider if you wire one up).
NEXT_PUBLIC_CONTACT_EMAIL=admin@tmflife.com

# Public site URL — used for SEO canonical + Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://tmflife.com
